# Copy this file to keystore.properties (ignored by git) and fill it in to sign release builds.
# storeFile can be an absolute path; keep the keystore and this file out of the repository and
# back them up: without the keystore you can't publish updates of the app.
storeFile=C:/Users/you/keys/bit-perfect-detector.jks
storePassword=
keyAlias=bitperfect
keyPassword=
