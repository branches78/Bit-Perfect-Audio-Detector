<?xml version="1.0" encoding="utf-8"?>
<!--
    The date of the last report sent (shared preferences "reports") isn't backed up or moved to a
    new phone: otherwise a restored phone couldn't send its own report for 48 hours.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="reports.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="reports.xml" />
    </device-transfer>
</data-extraction-rules>
